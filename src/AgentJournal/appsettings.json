{
  "AgentJournal": {
    "DatabasePath": "~/.agent-journal/sessions.db",
    "IndexPath": "~/.agent-journal/index",
    "Agents": {
      "ClaudeCode": {
        "Enabled": true,
        "SessionsPath": "~/.claude/sessions"
      },
      "CopilotCli": {
        "Enabled": true,
        "SessionsPath": "~/.github-copilot-cli/sessions"
      }
    },
    "Search": {
      "DefaultMode": "lexical",
      "MaxResults": 10,
      "ContextMessages": 2
    },
    "Export": {
      "DefaultFormat": "html",
      "OutputDirectory": "~/.agent-journal/exports"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning"
    }
  }
}
